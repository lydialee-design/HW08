# ==========================================
# 聚餐費用試算器（含三個測試案例）
# ==========================================

print("==========================================")
print("             【測試一】4 人，折價券 100 元")
print("==========================================")

# 1. 原始資料與字串處理（測試一）
input_meal_cost_1 = "  1200  "
input_service_rate_1 = "0.1"
input_discount_1 = "100"
input_people_count_1 = "4"
input_budget_1 = "300"

clean_meal_1 = input_meal_cost_1.strip()
clean_rate_1 = input_service_rate_1.strip()
clean_disc_1 = input_discount_1.strip()
clean_people_1 = input_people_count_1.strip()
clean_budget_1 = input_budget_1.strip()

# 2. 文字轉數字
meal_1 = float(clean_meal_1)
rate_1 = float(clean_rate_1)
disc_1 = float(clean_disc_1)
people_1 = int(clean_people_1)
budget_1 = float(clean_budget_1)

# 3. 計算步驟分開寫
service_fee_1 = meal_1 * rate_1            # 服務費（以原始餐費計算）
subtotal_1 = meal_1 + service_fee_1         # 暫時總額
final_total_1 = subtotal_1 - disc_1         # 最終應付總額
per_person_1 = final_total_1 / people_1     # 每人費用

# 4. 布林判斷（是否超過預算）
is_over_1 = (per_person_1 > budget_1)

# 5. 輸出測試一結果
print("應付總額：" + str(final_total_1) + " 元")
print("每人費用：" + str(per_person_1) + " 元")
print("是否超過預算：" + str(is_over_1))


