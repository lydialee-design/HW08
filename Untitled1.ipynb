# ==========================================
# Python 資料型別實作作業：聚餐費用試算器
# ==========================================

# 共用參數設定
service_rate = 0.10
budget_per_person = 300

# ------------------------------------------
# 測試一：4 人，折價券 100 元
# ------------------------------------------
event_raw_1 = "  WEEKEND DINNER  "
meal_raw_1 = " NT$1,200 "
people_raw_1 = "4"
discount_1 = 100

# 1. 整理聚餐名稱：去除頭尾空白並轉成小寫
event_name_1 = event_raw_1.strip().lower()

# 2. 整理餐費與人數並轉換型別（移除 "NT$"、逗號與空白）
cleaned_amount_str_1 = meal_raw_1.replace("NT$", "").replace(",", "").strip()
meal_amount_1 = float(cleaned_amount_str_1)
people_1 = int(people_raw_1)

# 3. 分步計算費用
service_fee_1 = meal_amount_1 * service_rate
total_amount_1 = meal_amount_1 + service_fee_1 - discount_1
cost_per_person_1 = total_amount_1 / people_1

# 4. 判斷是否超過預算
is_over_budget_1 = cost_per_person_1 > budget_per_person

# 5. 輸出測試一結果
print("【測試一】使用原始資料：4 人、折價券 100 元")
print("聚餐名稱：" + event_name_1)
print("原始餐費：" + str(f"{meal_amount_1:.2f}") + " 元")
print("服務費：" + str(f"{service_fee_1:.2f}") + " 元")
print("折價券：" + str(f"{float(discount_1):.2f}") + " 元")
print("應付總額：" + str(f"{total_amount_1:.2f}") + " 元")
print("分攤人數：" + str(people_1) + " 人")
print("每人費用：" + str(f"{cost_per_person_1:.2f}") + " 元")
print("每人預算：" + str(f"{float(budget_per_person):.2f}") + " 元")
print("是否超過預算：" + str(is_over_budget_1))
print("-" * 30)


